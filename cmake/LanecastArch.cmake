# Detects the target architecture and which ISA tiers can be compiled.
# Sets LANECAST_ARCH (arm64, x86_64 or generic), LANECAST_HAVE_<ISA> (ON/OFF)
# and LANECAST_FLAGS_<ISA> (per-TU compile flags for that tier).
include(CheckCXXCompilerFlag)

set(_lc_proc "${CMAKE_SYSTEM_PROCESSOR}")
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
  list(LENGTH CMAKE_OSX_ARCHITECTURES _lc_n)
  if(_lc_n GREATER 1)
    message(FATAL_ERROR "Universal builds are not supported; configure one architecture per build dir")
  endif()
  set(_lc_proc "${CMAKE_OSX_ARCHITECTURES}")
endif()
string(TOLOWER "${_lc_proc}" _lc_proc)

if(_lc_proc MATCHES "^(aarch64|arm64)$")
  set(LANECAST_ARCH arm64)
elseif(_lc_proc MATCHES "^(x86_64|amd64|x64)$")
  set(LANECAST_ARCH x86_64)
else()
  set(LANECAST_ARCH generic)
endif()

set(LANECAST_HAVE_NEON OFF)
set(LANECAST_HAVE_NEON_DOTPROD OFF)
set(LANECAST_HAVE_NEON_I8MM OFF)
set(LANECAST_HAVE_SSE41 OFF)
set(LANECAST_HAVE_AVX2 OFF)

set(LANECAST_FLAGS_NEON "")
set(LANECAST_FLAGS_NEON_DOTPROD "-march=armv8.2-a+dotprod")
set(LANECAST_FLAGS_NEON_I8MM "-march=armv8.2-a+dotprod+i8mm")
set(LANECAST_FLAGS_SSE41 "-msse4.1")
set(LANECAST_FLAGS_AVX2 "-mavx2")

if(LANECAST_ENABLE_SIMD)
  if(LANECAST_ARCH STREQUAL "arm64")
    set(LANECAST_HAVE_NEON ON)  # NEON is baseline on AArch64.
    check_cxx_compiler_flag("${LANECAST_FLAGS_NEON_DOTPROD}" LANECAST_CC_DOTPROD)
    check_cxx_compiler_flag("${LANECAST_FLAGS_NEON_I8MM}" LANECAST_CC_I8MM)
    if(LANECAST_CC_DOTPROD)
      set(LANECAST_HAVE_NEON_DOTPROD ON)
    endif()
    if(LANECAST_CC_I8MM)
      set(LANECAST_HAVE_NEON_I8MM ON)
    endif()
  elseif(LANECAST_ARCH STREQUAL "x86_64")
    check_cxx_compiler_flag("${LANECAST_FLAGS_SSE41}" LANECAST_CC_SSE41)
    check_cxx_compiler_flag("${LANECAST_FLAGS_AVX2}" LANECAST_CC_AVX2)
    if(LANECAST_CC_SSE41)
      set(LANECAST_HAVE_SSE41 ON)
    endif()
    if(LANECAST_CC_AVX2)
      set(LANECAST_HAVE_AVX2 ON)
    endif()
  endif()
endif()
